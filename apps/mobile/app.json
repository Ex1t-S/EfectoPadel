{
  "expo": {
    "name": "Efecto Padel",
    "slug": "efecto-padel-app",
    "scheme": "efectopadel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.efectopadel.app"
    },
    "android": {
      "package": "com.efectopadel.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
